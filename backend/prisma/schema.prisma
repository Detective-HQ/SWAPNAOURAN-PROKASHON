generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum BookType {
  PHYSICAL
  EBOOK
  ENGLISH_BOOK
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum DeliveryStatus {
  PROCESSING
  SHIPPED
  IN_TRANSIT
  DELIVERED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  SUCCESS
  FAILED
}

enum DisputeStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum PaymentProvider {
  MOCK
  STRIPE
  RAZORPAY
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  password      String
  role          Role          @default(USER)
  phone         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orders        Order[]
  ebookAccesses EbookAccess[]
  qrCodes       QRCode[]
  galleryImages Gallery[]     @relation("GalleryUploader")
  addresses     Address[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  returnRequests ReturnRequest[]

  @@index([role])
}

model Book {
  id               String        @id @default(cuid())
  title            String
  description      String
  authorName       String?
  isbn             String?
  pageCount        Int?
  bindingDetails   String?
  weight           String?
  stockQuantity    Int           @default(0)
  copiesSold       Int           @default(0)
  price            Decimal       @db.Decimal(10, 2)
  mrp              Decimal?      @db.Decimal(10, 2)
  discountPercentage Decimal?    @db.Decimal(5, 2)
  type             BookType
  coverImage       String?
  fileUrl          String?
  sampleChapterUrl String?
  isActive         Boolean       @default(true)

  // Shiprocket shipping dimensions
  sku              String?       @unique
  hsn              String?
  lengthCm         Decimal?      @db.Decimal(8, 2)
  breadthCm        Decimal?      @db.Decimal(8, 2)
  heightCm         Decimal?      @db.Decimal(8, 2)
  weightGrams      Decimal?      @db.Decimal(10, 2)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  orderItems       OrderItem[]
  ebookAccesses    EbookAccess[]
  qrCodes          QRCode[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  returnRequests   ReturnRequest[]

  @@index([type])
  @@index([isActive])
  @@index([title])
}

model Order {
  id              String          @id @default(cuid())
  userId          String
  status          OrderStatus     @default(PENDING)
  totalAmount     Decimal         @db.Decimal(10, 2)
  subtotalAmount  Decimal?        @db.Decimal(10, 2)
  deliveryCharge  Decimal         @default(0) @db.Decimal(10, 2)
  shippingAddress Json?
  invoiceNumber   String?         @unique
  trackingNumber  String?
  deliveryStatus  DeliveryStatus?

  // Shiprocket integration
  shiprocketOrderId    String?
  shiprocketShipmentId String?
  awbCode              String?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  payment         Payment?
  ebookAccesses   EbookAccess[]
  qrCodes         QRCode[]
  returnRequests  ReturnRequest[]
  disputes        Dispute[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  bookId     String
  quantity   Int      @default(1)
  unitPrice  Decimal  @db.Decimal(10, 2)
  totalPrice Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@unique([orderId, bookId])
  @@index([bookId])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String          @unique
  provider          PaymentProvider @default(MOCK)
  providerPaymentId String?
  status            PaymentStatus   @default(CREATED)
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("INR")
  payload           Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([provider])
  @@index([status])
  @@index([providerPaymentId])
}

model EbookAccess {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  orderId   String
  grantedAt DateTime @default(now())
  expiresAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId, orderId])
  @@index([userId, bookId])
}

model QRCode {
  id            String   @id @default(cuid())
  userId        String
  bookId        String
  orderId       String
  imageUrl      String
  qrData        Json
  scannedCount  Int      @default(0)
  lastScannedAt DateTime?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book          Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, bookId])
  @@index([orderId])
}

model Gallery {
  id           String   @id @default(cuid())
  title        String?
  imageUrl     String
  publicId     String?
  uploadedById String?
  createdAt    DateTime @default(now())
  uploadedBy   User?    @relation("GalleryUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById])
  @@index([createdAt])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
}

model ReturnRequest {
  id             String       @id @default(cuid())
  orderId        String
  userId         String
  bookId         String
  reason         String
  status         ReturnStatus @default(PENDING)
  adminNote      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  book           Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model Dispute {
  id                  String        @id @default(cuid())
  orderId             String
  ndrId               String?       @unique
  shiprocketDisputeId String?
  awbCode             String?
  issueType           String?
  description         String
  adminNotes          String?
  customerName        String?
  customerPhone       String?
  status              DisputeStatus @default(OPEN)
  resolution          String?
  ndrData             Json?
  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([ndrId])
}

model Newsletter {
  id          String   @id @default(cuid())
  email       String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  unsubscribedAt DateTime?

  @@index([email])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  address   String
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
